.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/

# Local development
.env
.env.local

# AI Provenance data (don't commit test databases)
*.db
*.db-shm
*.db-wal
.ai-provenance/
